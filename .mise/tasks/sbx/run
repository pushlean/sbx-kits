#!/usr/bin/env bash
#MISE description="[host-only] Run Docker sandbox with local template and default kits"
#USAGE flag "-s --sandbox-slug <slug>" help="Override sandbox slug (default: <agent>-<workdir>)"
#USAGE flag "-a --agent <agent>" help="Agent used in the sandbox" default="claude"
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

# FIXME need to define this globally
AGENT="${usage_agent:-claude}"
# FIXME can't assume git root is sandbox workdir in a monorepo
WORKDIRPATH="$(git rev-parse --show-toplevel)"
WORKDIR="$(basename "$WORKDIRPATH")"
if [ -n "${usage_sandbox_slug:-}" ]; then
  SANDBOX="$usage_sandbox_slug"
else
  SANDBOX="${AGENT}-${WORKDIR}"
fi

if ! sbx ls 2>/dev/null | grep -qw "$SANDBOX"; then
  sbx create --template "$TEMPLATE" --name "$SANDBOX" "$AGENT" "$WORKDIRPATH"
fi

exec sbx run $SANDBOX
